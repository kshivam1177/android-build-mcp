{
  "name": "testorbit",
  "version": "0.1.52",
  "description": "TestOrbit — record once, replay fast, forever. A Model Context Protocol (MCP) server and CLI for testing any app: Android, iOS, Flutter and web. Record a flow once in plain language, replay it deterministically with zero LLM calls, export Maestro YAML or Playwright tests.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "testorbit": "build/cli/index.js",
    "orbit": "./build/testorbit/cli/index.js",
    "skill-gen": "build/cli/skill-gen.js"
  },
  "main": "build/mcp/server.js",
  "exports": {
    ".": "./build/mcp/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build",
    "examples",
    "docs",
    "config.example.yaml",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "test-automation",
    "android",
    "ios",
    "flutter",
    "web",
    "maestro",
    "playwright",
    "record-replay",
    "ai-agent",
    "claude",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node build/cli/index.js mcp",
    "typecheck": "tsc --noEmit",
    "start:mcp": "node build/cli/index.js mcp",
    "doctor": "node build/cli/index.js doctor",
    "inspect": "npx -y @modelcontextprotocol/inspector node build/cli/index.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:testorbit": "eslint src/testorbit",
    "typecheck:testorbit": "tsc -p tsconfig.testorbit.json --noEmit",
    "testorbit:check-layout": "npm run build && node build/testorbit/cli/check-layout.js",
    "testorbit:ci": "npm run typecheck && npm run typecheck:testorbit && npm run lint && npm run lint:testorbit && npm run testorbit:check-layout && npm test && npm run coverage",
    "docs:generate": "npm run build && node scripts/generate-tool-inventory.mjs --write",
    "docs:check": "npm run build && node scripts/generate-tool-inventory.mjs --check",
    "test:gate": "node scripts/evaluate-test-gate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fast-xml-parser": "^5.12.0",
    "yaml": "^2.4.5",
    "yargs": "^17.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.32",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kshivam1177/android-mcp-framwork.git"
  },
  "homepage": "https://github.com/kshivam1177/android-mcp-framwork#readme",
  "bugs": {
    "url": "https://github.com/kshivam1177/android-mcp-framwork/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
